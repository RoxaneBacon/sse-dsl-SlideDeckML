{
    author: "Your Company Name"
    title: "Professional Business Presentation"
    theme: "white"
    css: ".reveal h1 {
                color: #1a1a1a;
                font-weight: 700;
                font-size: 2.5em;
            }
            .reveal h2 {
                color: #0066cc;
                font-weight: 600;
                border-bottom: 3px solid #0066cc;
                padding-bottom: 10px;
            }
            .reveal h3 {
                color: #333333;
                font-weight: 500;
            }
            .header-banner {
                position: fixed;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 60px;
                background-color: #0066cc;
                display: flex;
                align-items: center;
                justify-content: space-between;
                z-index: 1000;
                box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.15);
            }
            .header-author {
                color: #ffffff;
                font-size: 18px;
                font-weight: 600;
                margin-left: 30px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }
            .header-logo {
                height: 45px;
                width: auto;
                margin-right: 30px;
            }
            .reveal {
                margin-bottom: 60px;
            }
            .reveal .slides section {
                text-align: left;
            }
            .reveal strong {
                color: #0066cc;
            }
            .reveal ul {
                list-style-type: none;
            }
            .reveal ul li:before {
                content: '▸';
                color: #0066cc;
                font-weight: bold;
                margin-right: 10px;
            }"
}
